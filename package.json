{
  "name": "legacy-migration-agent",
  "version": "0.1.0",
  "description": "Point a read-only Claude agent at a legacy codebase and get an evidence-cited migration and decommission plan.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Caleb Boulio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cBoulio/legacy-migration-agent.git"
  },
  "keywords": [
    "claude-agent-sdk",
    "legacy",
    "migration",
    "decommission",
    "static-analysis",
    "agents"
  ],
  "bin": {
    "legacy-migrate": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dry-run": "node dist/cli.js analyze examples/legacy-invoicing/app --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
